# ---------------------------------------------------------------------------
# Plantilla de variables de entorno.
# Copia a `.env` (queda en el .gitignore) y rellena tus claves.
#   copy .env.example .env
# ---------------------------------------------------------------------------

# Entorno de ejecucion: development | production
APP_ENV=development

# --- YouTube Data API v3 ---------------------------------------------------
# Sin esta clave la app arranca en MODO SIMULACION (datos falsos pero
# reproducibles). Consigue una clave gratis en Google Cloud Console ->
# habilita "YouTube Data API v3" -> crea una API Key.
# El dataset se indica con YOUTUBE_API_KEY (un solo canal, el principal).
YOUTUBE_API_KEY=PEGA_AQUI_TU_CLAVE

# --- Limites del analisis --------------------------------------------------
# Comentarios por analisis (por defecto y maximo de la muestra).
MAX_COMMENTS=300
# Paginas de la YouTube Data API a recorrer (100 comentarios por pagina).
MAX_API_PAGES=10
REQUEST_TIMEOUT=10

# Cambia esta cadena para obtener otro dataset simulado distinto.
SIMULATION_SALT=assembly-v1

# --- Asistente IA (Groq, tier gratuito) -------------------------------------
# Sin clave la app funciona igual: el robot asistente no se muestra.
# Consigue una clave gratis en https://console.groq.com -> API Keys.
# (Tambien se acepta LLM_API_KEY; en Render se guarda como GROQ_API_KEY).
GROQ_API_KEY=PEGA_AQUI_TU_CLAVE_GROQ
# Modelo por defecto del tier gratis (30 req/min, ~14.400 req/dia).
LLM_MODEL=openai/gpt-oss-20b
LLM_TIMEOUT=25