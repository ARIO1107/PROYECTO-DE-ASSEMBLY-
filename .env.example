# ---------------------------------------------------------------------------
# Plantilla de variables de entorno.
# Copia a `.env` (queda en el .gitignore) si quieres sobreescribir valores.
#   copy .env.example .env
#
# TODAS son opcionales: la aplicacion arranca sin ninguna y es un simulador
# puro (no usa datos reales ni claves de API).
# ---------------------------------------------------------------------------

# Entorno de ejecucion: production | development
# En `development` el servidor arranca con recarga en caliente.
APP_ENV=production

# Puerto de escucha. Render / Railway / Docker lo inyectan automaticamente.
PORT=8000

# Nombre y version que se muestran en el panel.
APP_NAME=SocialBotGuard
APP_VERSION=2.0.0
